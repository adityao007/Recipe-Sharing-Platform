{
  "name": "recipe-sharing-platform",
  "version": "1.0.0",
  "description": "Recipe sharing app",
  "main": "server.js",
  "scripts": {
    "start": "npm run build && node server.js",
    "dev": "concurrently \"PORT=3001 npm run server\" \"npm run client\"",
    "server": "nodemon server.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-client": "cd client && npm install",
    "postinstall": "npm run install-client",
    "seed": "node seed.js",
    "kill-port": "lsof -ti:3000 | xargs kill -9 2>/dev/null || echo 'No process found on port 3000'",
    "check-port": "lsof -i:3000 || echo 'Port 3000 is available'"
  },
  "keywords": ["recipe", "sharing", "categories"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "body-parser": "^1.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}

